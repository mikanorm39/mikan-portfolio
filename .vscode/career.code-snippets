{
  // src/data/career.ts の career 配列の中で「career」と打って Tab → 経歴を1件追加するひな形が出る
  // Tab を押すたびに 日付 → タイトル → 説明文 → 種類 の順に移動する（種類は一覧から選ぶ）
  // 種類を2つ以上付けたいときは、選んだあとに , "dev" のように書き足す
  "経歴を1件追加": {
    "scope": "typescript",
    "prefix": "career",
    "description": "Career（経歴）を1件追加する",
    "body": [
      "{",
      "  date: \"${1:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}\",",
      "  title: \"$2\",",
      "  description: \"$3\",",
      "  tags: [${4|\"circle\",\"event\",\"dev\",\"award\",\"other\"|}],",
      "},$0"
    ]
  }
}
